# Apache / LiteSpeed / cPanel Configuration for Apex Books
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Deny direct browser access to the sqlite database file
    RewriteRule ^data/.*\.sqlite$ - [F,L]
</IfModule>

# Protect sensitive server files from direct web requests
<FilesMatch "^(config\.php|.*\.sqlite|\.env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Enable Gzip Compression for Fast Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
